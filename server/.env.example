# Copy this file to .env and fill in real values. Never commit .env.

PORT=5000
NODE_ENV=development

# MongoDB connection string (MongoDB Atlas free tier works well)
MONGODB_URI=mongodb://127.0.0.1:27017/brahmadev_kallali

# Long random string used to sign admin login tokens.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend address during development (Vite dev server)
CLIENT_URL=http://localhost:5173

# ---- Optional: Razorpay for automatic online donations ----
# Leave blank to use only the UPI QR code (entries then added by the trust admin).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Optional: Cloudinary for Photo Gallery storage ----
# Sign up at https://cloudinary.com for free tier (25 GB storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=