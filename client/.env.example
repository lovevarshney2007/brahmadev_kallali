# Client Environment Variables
# Copy this file to .env.local and fill in real values

# API Base URL (for production deployment on Vercel)
# On Vercel, this should be empty or "/" to use same-origin relative paths
# For local dev with separate backend: http://localhost:5000
VITE_API_URL=

# Optional: Razorpay Key ID (if you want to expose it to frontend for pre-fill)
# VITE_RAZORPAY_KEY_ID=

# Optional: Google Analytics / Analytics ID
# VITE_GA_ID=